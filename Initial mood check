#addressing the state of mood the user is in. Practicing exception handling. Building an ongoing output
while True:
    try:
        mood_scale = int(input("What is your mood from 0 to 10(0 being the worst and 10 being the best): "))

        if 0 <= mood_scale <= 10:
            break
        else:
            print("Please enter a number from 0 to 10.")

    except ValueError:
        print("Please enter a whole number, nothing with letters included.")

if mood_scale >= 8:
	out += "It's great that you're having such a good day!  It would be a really good idea to reflect back on your day so that this type of day can be repetitive.  "
elif mood_scale >= 5:
	out += "It's true, there's a lot of work that needs to be done and this program it's designed to show you that you're doing it.  "
elif mood_scale >= 1:
	out += "The systems are built so that we think that we're not doing enough.  You are for sure enough and we're going to get through whatever storm that approaches with God by your side!  "
elif mood_scale == 0:
	out += "If you made it this far, know there is still time for things to change.  It all starts from within; let's go!  "
	
	
