while True:
    try:
        mood_scale = int(input("What is your mood from 0 to 10: "))

        if 0 <= mood_scale <= 10:
            break
        else:
            print("Please enter a number from 0 to 10.")

    except ValueError:
        print("Please enter a whole number, nothing with letters included.")


